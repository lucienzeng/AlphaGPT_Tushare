    "期货_数据覆盖": {
      "type": "view",
      "sql": "CREATE VIEW \"期货_数据覆盖\" (数据接口,数据类别,合约或交易所,行数,起始日期,结束日期,最后入库时间) AS SELECT 'fut_basic' AS 数据接口,'合约信息' AS 数据类别,_scope AS 合约或交易所,count(*) AS 行数,NULL,NULL,max(_updated_at) AS 最后入库时间 FROM contracts GROUP BY _scope UNION ALL SELECT 'fut_trade_cal' AS 数据接口,'交易日历' AS 数据类别,_scope AS 合约或交易所,count(*) AS 行数,min(cal_date),max(cal_date),max(_updated_at) AS 最后入库时间 FROM trade_calendar GROUP BY _scope UNION ALL SELECT 'fut_daily' AS 数据接口,'月份合约日线' AS 数据类别,_scope AS 合约或交易所,count(*) AS 行数,min(trade_date),max(trade_date),max(_updated_at) AS 最后入库时间 FROM daily_bars GROUP BY _scope UNION ALL SELECT 'fut_mapping' AS 数据接口,'主连映射' AS 数据类别,_scope AS 合约或交易所,count(*) AS 行数,min(trade_date),max(trade_date),max(_updated_at) AS 最后入库时间 FROM main_mapping GROUP BY _scope UNION ALL SELECT 'ft_limit' AS 数据接口,'涨跌停与保证金' AS 数据类别,_scope AS 合约或交易所,count(*) AS 行数,min(trade_date),max(trade_date),max(_updated_at) AS 最后入库时间 FROM price_limits GROUP BY _scope UNION ALL SELECT 'fut_settle' AS 数据接口,'结算参数' AS 数据类别,_scope AS 合约或交易所,count(*) AS 行数,min(trade_date),max(trade_date),max(_updated_at) AS 最后入库时间 FROM settlement_params GROUP BY _scope",
